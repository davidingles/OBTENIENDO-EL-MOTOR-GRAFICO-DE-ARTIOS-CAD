<!-- The following section (MAIN_MODEL) helps with finding the main Score Model to import -->
<!-- The main model is used to create the ArtiosCAD Main Design layer and the main Dimension layer.
     All dimension items from all layers of the main Model will be inserted in to a Dimension layer
     while all other items will be placed in the Main Design layer.    -->

<MAIN_MODEL>
  <!-- The main model can be found by first looking for a named Sheet.
       A Sheet name search list can be defined using <SHEET_SEARCH_LIST>.
       A name of "*" means to use the first Sheet     -->
  <!-- sheet search list -->
  <SHEET_SEARCH_LIST>
    <SHEET name="Full-Current"/>
  </SHEET_SEARCH_LIST>

  <!-- The active model associated with a sheet is actually stored in a child View object.
       A View name search list can be defined using <VIEW_SEARCH_LIST>.
       A name of "*" means to use the first View     -->
  <!-- view search list (within sheet) -->
  <VIEW_SEARCH_LIST>
    <VIEW name="*"/>
  </VIEW_SEARCH_LIST>

  <!-- If Score Sheets were not used or if the Sheet was not found using the SHEET_SEARCH_LIST,
       The main Model can still be found using a <MODEL_SEARCH_LIST>.
       A name of "*" means to use the first Model     -->
  <!-- model search list -->
  <MODEL_SEARCH_LIST>
    <MODEL name="Model 1"/>
    <MODEL name="*"/>
  </MODEL_SEARCH_LIST>

  <!-- You may want to prevent certain layers of the main Model from being imported.
       The <LAYER_SKIP_LIST> allows you to specify a list of layers to skip (no wildcards) -->
  <LAYER_SKIP_LIST>
    <LAYER name="Foldup"/>
  </LAYER_SKIP_LIST>


  <!-- The following tag specifies the name of the main Dimension layer created.
       "Dimension" will be used if this tag is not defined -->
  <MAIN_DIMENSION_LAYER_NAME name="Dimension"/>

  <!-- The following tag specifies the name of the main Construction layer created.
       Construction lines will not be split out to a Construction layer if this tag is not defined -->
  <MAIN_CONSTRUCTION_LAYER_NAME name="Construction"/>

</MAIN_MODEL>


<!-- The other remaining Models can also be imported using the following options.
     Each layer of any other Models found is imported as an Annotation layer where
     the layer name is a combination of the Model name and Layer name
     If this <OTHER_MODELS> tag is skipped - no other Models are imported      -->
<OTHER_MODELS>
  
  <!-- You may want to skip certain other Models from being imported.
       The <MODEL_SKIP_LIST> allows you to specify a list of other Models to skip (no wildcards)   -->
  <MODEL_SKIP_LIST>
    <MODEL name="Foldup"/>
  </MODEL_SKIP_LIST>

  <!-- You may want to prevent certain layers across the other Models from being imported.
       The <LAYER_SKIP_LIST> allows you to specify a list of layers to skip (no wildcards)   -->
  <LAYER_SKIP_LIST>
    <LAYER name="Foldup"/>
  </LAYER_SKIP_LIST>

</OTHER_MODELS>

<!-- The following tag specifies has options for displaying text in a GDT object.
     font - is the name of the font to use
     sizefactor - is the multiplication factor to adjust the height of the text 
     xoffsetsizefactor - height multiplication factor to adjust the starting x offset of the GDT - default =0
     yoffsetsizefactor - height multiplication factor to adjust the starting y offset of the GDT - default =0.4
-->
<GDT_OPTIONS font="MS UI Gothic" sizefactor="10"/>

<CROSS_HATCH_MAPPING>
  <!-- Maps Score Cross Hatch pattern into a simple ArtiosCAD hatch patern.
       The mapping is based on the Score Hatch name

       Below is an example showing all the possible attributes
       <CROSS_HATCH_MAP name="Iron" angle="45" width="5" crossangle="90" type="2" pointage="1.5"/>
       where
           name - is the Score crosshatch name, use "*" for a wildcard, case insensitive
           angle - the main ArtiosCAD hatch line angle in degrees
           width - the spacing between hatch lines (in mm)
           crossangle - cross hatch line angle (if omitted not cross lines)
           type - the cross hatch destination line type
                  (if omitted the line type of the first line in the bounding path will be used)
           pointage - the destination line pointage

     If no mapping is specified, the following map is automattically applied
         <CROSS_HATCH_MAP name="*" angle="45" width="5" />
  -->
    <CROSS_HATCH_MAP name="*" angle="45" crossangle="135" width="5" />
</CROSS_HATCH_MAPPING>

<FONT_MAPPING>
  <!-- Maps Score font to an ArtiosCAD font.
       The mapping is based on the font name

       Below is an example showing all the possible attributes
       <FONT_MAP name="Arial" newname="Courier"/>
       where
           name - is the name of the font in the Score file, use "*" for a wildcard, case insensitive
           newname - is the name of the new font in ArtiosCAD
  -->
<FONT_MAP name="*" newname="MS UI Gothic"/>
</FONT_MAPPING>

<!-- For 3D support, the 3D fold angles and base face can also be imported.
     These are typically found on the creases in the Foldup layer of the Foldup model
     If this <FOLDUP> tag is skipped fold angles are not imported      -->
<FOLDUP>
  <FOLDUP_SEARCH model="Foldup" layer="Foldup"/>
  <FOLDUP_SEARCH model="Model 1" layer="Foldup"/>
</FOLDUP>

</SCORE_IMPORT_TUNE>





