<SCORE_IMPORT_TUNE version="1.0">

<!--  Options to control design Side/Grain
         the use_value_from_file attribute can have a value of 
                0 - which means to ignore the side/grain values from the Score file
                      and allow them to be set from the Single Design Parameter set
                1 - which means to try to load the side/grain value from the Score file
                      If the side/grain value cannot be found then the values from the
                      parameter set are used.(this is the default when not defined)
<DESIGN_SIDE use_value_from_file="0"/>
<DESIGN_GRAIN use_value_from_file="1"/>
-->

<!-- special rule definition -->
<SPECIAL_RULE_LIST>
  <!-- Custom ArtiosCAD special rules can be defined here (max 40) and will automatically
       be created in the new ArtiosCAD file. These rules can be used in the LINE_TYPE_MAPPING
       (below) by specifying the name in the spname attribute.

       SPECIAL_RULEs have unique parameters based on the generic rule type (gentype).  These
       are defined in the defstring1, defstring2 and defstring3 attributes and can be copied 
       from other ArtiosCAD import tuning files (.itune).  To see what they might be, you can map
       dxf patterns to ArtiosCAD special rule.  The resulting .itune file might have this as an entry
       
       <SPECIALRULE>
       3 "1/2 1/2 perf"
       12.7000 12.7000 6.3500 0 0  
       0 0.0000
       0.0000 0.0000000 0 0 0.0000 0.0000 0.0000

       Below are examples of a special rule definition
           <SPECIAL_RULE name="1/2 1/2 perf" gentype="3" label="1/2 1/2 perf"
                defstring1="12.7000 12.7000 6.3500 0 0"
	        defstring2="0 0.0000"
                defstring3="0.0000 0.0000000 0 0 0.0000 0.0000 0.0000"/>

           <SPECIAL_RULE name="1/2 1/2 cut &amp; crease" gentype="5" label="My Label"
                defstring1="12.7000 12.7000 6.3500 2 0"
	        defstring2="0 0.0000"
                defstring3="0.0000 0.0000000 0 0 0.0000 0.0000 0.0000"/>
   -->
</SPECIAL_RULE_LIST>

<!-- line type mapping -->
<LINE_TYPE_MAPPING>
  <!-- Maps Score line input attributes to ArtiosCAD Line types.
       The mapping is applied in the order read and uses the first mapping which matches all the
       input attributes.  Any attribute which is not defined is considered a wildcard.

       Below is an example showing all the possible attributes
             <LINE_TYPE_MAP>
               <IN_ATTS  type="102" ruleid="2" auxtype="0" pointage="2" color="4" style="2" width="3"/> 
               <OUT_ATTS type="1" auxtype="0" pointage="2" /> 
             </LINE_TYPE_MAP>
  -->

  <!-- IN_ATTS can have attributes of
       type - Score 6+ line type - see Score 6 default line type table (below)
       ruleid - Score 6+ rule type 
       auxtype - Score 6+ auxtype
       pointage - Score 6+ pointage
       color - color attribute - see Score 6 default color table (below)
       style - pattern attribute (lnfont) - see Score 6 default pattern table (below)
       width - weight attribute (lnwidth) - see Score 6 default weight table (below)
   -->

  <!-- OUT_ATTS can have attributes of
       type - the destination ArtiosCAD line type - see default ArtiosCAD line type table (below)
       auxtype - destination ArtiosCAD subtype (ranges 0-100)
       pointage - destination ArtiosCAD pointage (number 0-9, and 1.5)
       spname - special rule name (must be defined in the SPECIAL_RULE_LIST above)
                In this case the type attribute is ignored
