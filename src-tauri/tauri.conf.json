{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Troqueles Vicente",
  "version": "0.2.0",
  "identifier": "es.troquelesvicente.estudio",
  "build": {
    "beforeBuildCommand": "node scripts/build-frontend.js",
    "beforeDevCommand": "node scripts/build-frontend.js",
    "frontendDist": "../web-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Troqueles Vicente",
      "width": 1440,
      "height": 960,
      "minWidth": 1050,
      "minHeight": 680,
      "maximized": true,
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": false }
}
